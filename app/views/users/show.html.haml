.row
  - @timeline_photos.each  do |photo|
    .well.col-sm-4
      = image_tag photo.image.url(:medium)
      - if photo.user_id == current_user.id
        = button_to "Delete Photo", user_photo_path(photo.user, photo), method: :delete
      = form_for @tag do |f|
        = f.hidden_field :photo_id, value: photo.id
        = f.collection_select :user_id, @users, :id, :email
        = f.submit "Tag User"
      - photo.tags.each do |tag|
        = tag.user.email
      %h3= photo.title
      %hr/
      %strong Comments:
      %ul
        - photo.comments.each do |comment|
          %li
            %b= comment.user.email
            = ": " + comment.text
            - if photo.user_id == current_user.id || comment.user_id == current_user.id 
              = button_to "Delete" , user_photo_comment_path(photo.user, photo, comment), method: :delete
            
      = form_for [photo.user, photo, Comment.new] do |f|
        = f.text_field :text, placeholder: "Write a comment"
        = f.submit "Confirm", class: ['btn', 'btn-info', 'btn-xs']

